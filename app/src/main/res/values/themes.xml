<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.BetMasters" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:navigationBarColor">@color/white</item>
    </style>

    <style name="Theme.BetMasters" parent="Base.Theme.BetMasters" />

    <style name="fondoApp">
        <item name="android:background">@color/input</item>
    </style>
    <style name="desplegable">
        <item name="android:background">@color/black</item>
    </style>
    <style name="fondoBottomsheet">
        <item name="android:background">@drawable/rounded_background</item>
    </style>
    <style name="fondoCardRedeem">
        <item name="android:background">@color/input</item>
    </style>
    <style name="cardCoins">
        <item name="android:backgroundTint">@color/dark_blue</item>
    </style>
    <style name="cardGame">
        <item name="android:backgroundTint">@color/grey_coins</item>
    </style>
    <style name="textCoins">
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
    </style>
    <style name="iconCoin">
        <item name="android:src">@drawable/redeem_night</item>
    </style>
    <style name="iconCoin2">
        <item name="android:src">@drawable/redeem</item>
    </style>
    <style name="iconHome">
        <item name="android:src">@drawable/home</item>
    </style>
    <style name="iconGame">
        <item name="android:src">@drawable/game</item>
    </style>
    <style name="iconGameArrow">
        <item name="android:src">@drawable/arrow_game</item>
    </style>
    <style name="iconArrowBack">
        <item name="android:background">@drawable/baseline_arrow_back_ios_new_24</item>
    </style>
    <style name="lenguage">
        <item name="android:src">@drawable/outline_g_translate_24</item>
    </style>
    <style name="edit">
        <item name="android:src">@drawable/baseline_edit_square_24</item>
    </style>
    <style name="overlayCorazon">
        <item name="android:layout_width">35dp</item>
        <item name="android:layout_height">35dp</item>
        <item name="android:src">@drawable/fav</item>
        <item name="android:alpha">0.7</item>
        <item name="android:layout_gravity">top|end</item>
    </style>

    <style name="txtTeamFav">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="imgTeamFav">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
    </style>

    <style name="leagueHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@color/backAzulClarito</item>
        <item name="android:padding">8dp</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:visibility">gone</item>
    </style>
    <style name="betButton">
        <item name="android:backgroundTint">#939191</item>
        <item name="android:background">@drawable/custom_button_background</item>
    </style>
    <style name="cardCoinBet">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:padding">4dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="linearLayoutCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="textCardCoinBet">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">16dp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>